---
import { SITE } from 'astrowind:config';
---

<span class="ml-2 flex items-center gap-2 self-center whitespace-nowrap rtl:ml-0 rtl:mr-2">
  <svg width="28" height="28" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0">
    <rect x="1" y="4" width="14" height="8" fill="#e9f2e3" stroke="#122b16" stroke-width="1.5"></rect>
    <line x1="5" y1="4" x2="5" y2="12" stroke="#122b16" stroke-width="1" stroke-dasharray="1 1"></line>
    <rect x="7" y="6" width="2" height="2" fill="#d42a5e"></rect>
    <rect x="10" y="6" width="2" height="2" fill="#1e7a4c"></rect>
  </svg>
  <span class="font-heading text-2xl font-bold text-[var(--text)] md:text-xl">{SITE?.name}</span>
</span>
