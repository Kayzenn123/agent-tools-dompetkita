---
import Layout from '~/layouts/PageLayout.astro';
import Note from '~/components/widgets/Note.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import { SITE, METADATA, I18N } from 'astrowind:config';
import '~/assets/styles/dompet.css';
import { KONTAK, ASSETS, SPEEDS, PELAJARAN, KUIS, FAQ_PAK_LOKET, MARQUEE_1, MARQUEE_2 } from '~/data/dompet';

const metadata = {
  title: 'DompetKita — Loket Latihan Dompet Kripto untuk Pemula',
  description:
    'Loket latihan dompet kripto berbahasa Indonesia. Kirim, terima, dan hitung biaya pakai uang contoh — tanpa risiko kehilangan uang sungguhan.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'DompetKita',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
    description: 'Simulator edukasi dompet kripto berbahasa Indonesia. Semua saldo, harga, dan alamat adalah contoh.',
  },
];

// Judul hero dipecah per huruf untuk animasi flip 3D (v4 C).
const judulBaris = ['LOKET', 'DOMPETKITA'];
let hurufKe = 0;
const marqueeItem = (teks: string) => teks.repeat(4);
---

<Layout metadata={metadata}>
  <!-- Matikan bar pengumuman demo template (promo AstroWind + badge shields.io eksternal). -->
  <Fragment slot="announcement" />
  <StructuredData slot="head" schema={structuredData} />

  <!-- Lapisan gerak: spotlight kursor + live region + toast -->
  <div id="spotlight" aria-hidden="true"></div>
  <div id="live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <div
    id="toast"
    role="status"
    class="fixed bottom-4 left-1/2 z-50 -translate-x-1/2 border-2 border-[var(--line)] bg-white px-4 py-3 font-bold opacity-0 transition-opacity duration-200 pointer-events-none"
  >
  </div>

  <!-- Marquee band 1 -->
  <div class="marquee-band bg-[var(--loket)] text-white" role="region" aria-label="Pengumuman loket">
    <div class="marquee-track font-mono text-sm font-bold tracking-wide py-2">
      <span>{marqueeItem(MARQUEE_1)}</span><span aria-hidden="true">{marqueeItem(MARQUEE_1)}</span>
    </div>
  </div>

  <!-- ============ LOKET / HERO ============ -->
  <section id="loket" class="board-lines relative overflow-hidden">
    <div id="board-zoom" class="board-zoom mx-auto max-w-6xl px-4 pb-10 pt-10 sm:pt-14">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-mono text-sm font-bold tracking-wide">
          <span class="pin mr-2 inline-block align-middle" aria-hidden="true"></span>
          LOKET BUKA · 24 JAM · UANG CONTOH — BUKAN UANG SUNGGUHAN
        </p>
        <button
          id="btn-gerak"
          type="button"
          class="btn-loket border-2 border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm font-bold"
          aria-pressed="true"
        >
          Gerak: nyala
        </button>
      </div>

      <h1 class="hero-title mt-6 text-[clamp(3rem,13vw,9rem)] font-bold">
        {
          judulBaris.map((baris) => (
            <span class="block">
              {[...baris].map((huruf) => (
                <span class="flip-letter" style={`--i:${hurufKe++}`}>
                  {huruf}
                </span>
              ))}
            </span>
          ))
        }
      </h1>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed">
        Selamat datang di loket, Mas/Mbak. Di sini Mas/Mbak bisa <strong>latihan kirim uang kripto</strong> pakai uang
        contoh — salah kirim pun tidak apa-apa, tidak ada yang hilang sungguhan. Pak Loket yang jaga.
      </p>

      <!-- Papan saldo -->
      <div class="sticker mt-8 p-5 sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="font-mono text-sm font-bold tracking-wide">SALDO KAMU (CONTOH)</p>
            <p id="saldo-total" class="font-mono text-[clamp(2rem,8vw,3.5rem)] font-bold leading-none" aria-live="polite">
              Rp250.000
            </p>
            <ul id="saldo-rincian" class="mt-3 max-w-md text-sm"></ul>
            <p class="mt-3 text-sm text-[var(--redup)]">
              Harga BTC/ETH di sini <strong>contoh</strong>, bukan harga pasar. Saldo tersimpan di browser kamu sendiri.
            </p>
          </div>
          <div class="text-center">
            <button
              id="nomor-antrean"
              type="button"
              class="btn-loket border-2 border-[var(--line)] bg-white px-4 py-3"
              aria-label="Nomor antrean kamu. Ketuk lima kali untuk kejutan."
            >
              <span class="block font-mono text-xs font-bold">NOMOR ANTREAN</span>
              <span class="nomor block font-mono text-3xl font-bold">A-001</span>
            </button>
            <span id="stempel-rahasia" class="stempel mt-3 px-3 py-1 text-sm">DIDAHULUKAN</span>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="#kirim"
            class="btn-loket inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-[var(--loket)] px-5 py-3 font-bold text-white"
          >
            <Icon name="tabler:send" class="h-5 w-5" aria-hidden="true" /> Kirim uang contoh
          </a>
          <a
            href="#terima"
            class="btn-loket inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-white px-5 py-3 font-bold"
          >
            <Icon name="tabler:arrow-down-left" class="h-5 w-5" aria-hidden="true" /> Terima uang contoh
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee band 2 -->
  <div class="marquee-band band-2 bg-[var(--surface-2)]" role="region" aria-label="Tarif contoh">
    <div class="marquee-track font-mono text-sm font-bold tracking-wide py-2">
      <span>{marqueeItem(MARQUEE_2)}</span><span aria-hidden="true">{marqueeItem(MARQUEE_2)}</span>
    </div>
    <p class="sr-only">
      Tarif contoh: biaya Santai Rp1.500, Biasa Rp4.000, Ngebut Rp9.000. Uang contoh, bukan uang sungguhan.
    </p>
  </div>
  <div class="mx-auto max-w-6xl px-4 pt-3 text-right">
    <button type="button" class="btn-jeda-marquee btn-loket border-2 border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm font-bold" aria-pressed="false">
      Jeda marquee
    </button>
  </div>

  <!-- ============ KIRIM ============ -->
  <section id="kirim" class="wipe mx-auto max-w-6xl px-4 py-12">
    <div class="sticker p-5 sm:p-8">
      <div class="flex items-start gap-3">
        <svg width="48" height="48" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0">
          <rect x="1" y="4" width="14" height="8" fill="none" stroke="#122b16" stroke-width="1.5"></rect>
          <line x1="5" y1="4" x2="5" y2="12" stroke="#122b16" stroke-width="1" stroke-dasharray="1 1"></line>
          <rect x="7" y="6" width="2" height="2" fill="#d42a5e"></rect>
          <rect x="10" y="6" width="2" height="2" fill="#1e7a4c"></rect>
          <circle cx="2.5" cy="8" r="1" fill="#e9f2e3" stroke="#122b16"></circle>
          <circle cx="13.5" cy="8" r="1" fill="#e9f2e3" stroke="#122b16"></circle>
        </svg>
        <div>
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">Kirim uang contoh</h2>
          <p class="mt-1 text-[var(--redup)]">Pilih orangnya, tulis jumlahnya, lihat ongkosnya — baru tempel stempel.</p>
        </div>
      </div>

      <form id="form-kirim" class="mt-6" novalidate>
        <fieldset>
          <legend class="font-bold">Kirim ke siapa?</legend>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Pilih kontak">
            {
              KONTAK.map((k, i) => (
                <label class="btn-loket inline-flex min-h-[44px] cursor-pointer items-center gap-2 border-2 border-[var(--line)] bg-white px-3 py-2 font-bold has-checked:bg-[var(--loket)] has-checked:text-white">
                  <input type="radio" name="kontak" value={k.nama} checked={i === 0} class="radio-nol" />
                  <span>{k.pendek}</span>
                  <span class="hidden font-normal sm:inline">· {k.peran}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="kirim-aset" class="font-bold">Aset</label>
            <select id="kirim-aset" class="mt-1 w-full border-2 border-[var(--line)] bg-white px-3 py-3">
              {
                ASSETS.map((a) => (
                  <option value={a.id}>
                    {a.nama} — saldo {a.id === 'IDR' ? 'Rp250.000' : a.id === 'BTC' ? '0,0021 BTC' : '0,045 ETH'}
                  </option>
                ))
              }
            </select>
          </div>
          <div>
            <label for="kirim-jumlah" class="font-bold">Jumlah</label>
            <input
              id="kirim-jumlah"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="Contoh: 50000"
              class="mt-1 w-full border-2 border-[var(--line)] bg-white px-3 py-3 font-mono"
              aria-describedby="jumlah-bantuan"
            />
            <p id="jumlah-bantuan" class="mt-1 text-sm text-[var(--redup)]">Pakai titik untuk desimal, contoh: 0.001</p>
          </div>
        </div>

        <fieldset class="mt-5">
          <legend class="font-bold">Kecepatan (ongkos tol)</legend>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Pilih kecepatan">
            {
              SPEEDS.map((s, i) => (
                <label class="btn-loket inline-flex min-h-[44px] cursor-pointer items-center gap-2 border-2 border-[var(--line)] bg-white px-3 py-2 font-bold has-checked:bg-[var(--loket)] has-checked:text-white">
                  <input type="radio" name="kecepatan" value={s.id} checked={i === 1} class="radio-nol" />
                  <span>{s.nama}</span>
                  <span class="font-mono font-normal">· {s.waktu}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div id="estimasi" class="mt-5 border-2 border-dashed border-[var(--line)] bg-white p-4 font-mono text-sm" aria-live="polite">
          <p id="est-biaya">Biaya: —</p>
          <p id="est-total" class="font-bold">Total: —</p>
          <p id="est-waktu">Perkiraan sampai: —</p>
          <p id="est-sisa">Saldo kamu: —</p>
        </div>

        <p id="kirim-error" role="alert" class="mt-4 border-2 border-[var(--pop)] bg-white p-3 font-bold text-[var(--pop)]" hidden></p>

        <button
          id="btn-kirim"
          type="submit"
          class="btn-loket mt-5 inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-[var(--loket)] px-6 py-3 font-bold text-white"
        >
          <Icon name="tabler:ticket" class="h-5 w-5" aria-hidden="true" /> Tempel stempel &amp; kirim
        </button>
      </form>

      <!-- Karcis hasil kirim -->
      <div id="karcis-hasil" class="mt-8" hidden>
        <article class="karcis mx-auto max-w-md p-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-mono text-sm font-bold tracking-wide"><span id="karcis-no">DK-000000</span> · CONTOH</p>
              <p id="karcis-waktu" class="font-mono text-xs text-[var(--redup)]"></p>
            </div>
            <span id="stempel-karcis" class="stempel px-2 py-1 text-xs">LUNAS</span>
          </div>
          <div class="karcis-divider my-3"></div>
          <p id="karcis-pihak" class="text-lg font-bold"></p>
          <p id="karcis-jumlah" class="font-mono text-3xl font-bold text-[var(--pop)]"></p>
          <p id="karcis-biaya" class="mt-1 font-mono text-sm text-[var(--redup)]"></p>
          <div class="mt-4 flex flex-wrap gap-2">
            <button id="btn-salin-karcis" type="button" class="btn-loket border-2 border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm font-bold">
              Salin karcis
            </button>
            <button id="btn-karcis-baru" type="button" class="btn-loket border-2 border-[var(--line)] bg-white px-3 py-2 text-sm font-bold">
              Kirim lagi
            </button>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ TERIMA ============ -->
  <section id="terima" class="wipe mx-auto max-w-6xl px-4 py-6">
    <div class="sticker p-5 sm:p-8">
      <div class="flex items-start gap-3">
        <Icon name="tabler:arrow-down-left" class="h-8 w-8 shrink-0" aria-hidden="true" />
        <div>
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">Terima uang contoh</h2>
          <p class="mt-1 text-[var(--redup)]">Ini alamat dompet latihanmu. Bagikan ke temanmu — tapi ingat, ini alamat contoh, bukan alamat sungguhan.</p>
        </div>
      </div>
      <div class="mt-5 overflow-x-auto border-2 border-[var(--line)] bg-white p-4">
        <code id="alamat-saya" class="font-mono text-sm font-bold break-all sm:text-base">memuat alamat…</code>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <button id="btn-salin-alamat" type="button" class="btn-loket inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-[var(--loket)] px-5 py-3 font-bold text-white">
          <Icon name="tabler:copy" class="h-5 w-5" aria-hidden="true" /> Salin alamat
        </button>
        <button id="btn-bagikan-alamat" type="button" class="btn-loket inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-white px-5 py-3 font-bold">
          <Icon name="tabler:share" class="h-5 w-5" aria-hidden="true" /> Bagikan sebagai teks
        </button>
      </div>
      <p class="mt-3 text-sm text-[var(--redup)]">
        Alamat boleh dibagikan ke siapa saja. Yang <strong>tidak boleh</strong> dibagikan adalah seed phrase — baca pelajaran 4 di bawah.
      </p>
    </div>
  </section>

  <!-- ============ KALKULATOR ============ -->
  <section id="kalkulator" class="wipe mx-auto max-w-6xl px-4 py-6">
    <div class="sticker p-5 sm:p-8">
      <div class="flex items-start gap-3">
        <Icon name="tabler:calculator" class="h-8 w-8 shrink-0" aria-hidden="true" />
        <div>
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">Kalkulator ongkos tol</h2>
          <p class="mt-1 text-[var(--redup)]">Hitung dulu sebelum kirim — jangan sampai ongkosnya lebih besar dari kirimannya.</p>
        </div>
      </div>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <label for="kalk-aset" class="font-bold">Aset</label>
          <select id="kalk-aset" class="mt-1 w-full border-2 border-[var(--line)] bg-white px-3 py-3">
            {ASSETS.map((a) => <option value={a.id}>{a.nama}</option>)}
          </select>
        </div>
        <div>
          <label for="kalk-jumlah" class="font-bold">Jumlah yang mau dikirim</label>
          <input id="kalk-jumlah" type="text" inputmode="decimal" autocomplete="off" placeholder="Contoh: 100000" class="mt-1 w-full border-2 border-[var(--line)] bg-white px-3 py-3 font-mono" />
        </div>
      </div>
      <fieldset class="mt-5">
        <legend class="font-bold">Kecepatan</legend>
        <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Pilih kecepatan kalkulator">
          {
            SPEEDS.map((s, i) => (
              <label class="btn-loket inline-flex min-h-[44px] cursor-pointer items-center gap-2 border-2 border-[var(--line)] bg-white px-3 py-2 font-bold has-checked:bg-[var(--loket)] has-checked:text-white">
                <input type="radio" name="kalk-kecepatan" value={s.id} checked={i === 1} class="radio-nol" />
                <span>{s.nama}</span>
                <span class="font-mono font-normal">· {s.waktu}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="mt-5 border-2 border-dashed border-[var(--line)] bg-white p-4 font-mono text-sm" aria-live="polite">
        <p id="kalk-biaya">Biaya jaringan: —</p>
        <p id="kalk-total" class="font-bold">Total yang keluar: —</p>
        <p id="kalk-waktu">Perkiraan sampai: —</p>
      </div>
    </div>
  </section>

  <!-- ============ BELAJAR ============ -->
  <section id="belajar" class="wipe mx-auto max-w-6xl px-4 py-6">
    <div class="sticker p-5 sm:p-8">
      <div class="flex items-start gap-3">
        <Icon name="tabler:book" class="h-8 w-8 shrink-0" aria-hidden="true" />
        <div>
          <h2 class="font-heading text-3xl font-bold sm:text-4xl">Belajar di bangku loket</h2>
          <p class="mt-1 text-[var(--redup)]">Lima pelajaran singkat, bahasa sehari-hari. Baca, tandai, lalu uji di kuis.</p>
        </div>
      </div>

      <div class="mt-5">
        <div class="flex items-center justify-between gap-3">
          <p id="belajar-progress-teks" class="font-bold">0 dari 5 pelajaran selesai dibaca</p>
          <p class="font-mono text-sm">Pak Loket mengawasi 👀 — eh, tidak pakai emoji. Pak Loket mengawasi.</p>
        </div>
        <div class="mt-2 h-4 border-2 border-[var(--line)] bg-white" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" aria-label="Kemajuan belajar">
          <div id="belajar-progress-bar" class="h-full bg-[var(--loket)] transition-all duration-300" style="width:0%"></div>
        </div>
      </div>

      <div class="mt-6 grid gap-4">
        {
          PELAJARAN.map((p, i) => (
            <details class="pelajaran border-2 border-[var(--line)] bg-white p-4" data-id={p.id}>
              <summary class="cursor-pointer font-bold text-lg marker:text-[var(--pop)]">
                Pelajaran {i + 1}: {p.judul}
              </summary>
              <div class="mt-3 space-y-2 leading-relaxed">
                {p.isi.map((par) => (
                  <p>{par}</p>
                ))}
              </div>
              <button type="button" class="btn-selesai btn-loket mt-4 border-2 border-[var(--line)] bg-[var(--surface)] px-3 py-2 text-sm font-bold">
                Tandai sudah dibaca
              </button>
            </details>
          ))
        }
      </div>

      <!-- Kuis -->
      <form id="form-kuis" class="mt-8 border-t-2 border-dashed border-[var(--line)] pt-6">
        <h3 class="font-heading text-2xl font-bold">Kuis Pak Loket — 5 soal</h3>
        <p class="mt-1 text-[var(--redup)]">Jawab semuanya, lalu tekan periksa. Penjelasan muncul di tiap soal.</p>
        <div class="mt-4 grid gap-4">
          {
            KUIS.map((soal, i) => (
              <fieldset data-soal={soal.id} class="border-2 border-[var(--line)] bg-white p-4">
                <legend class="px-2 font-bold">
                  Soal {i + 1}: {soal.tanya}
                </legend>
                <div class="mt-2 grid gap-2">
                  {soal.pilihan.map((pil, j) => (
                    <label class="btn-loket flex min-h-[44px] cursor-pointer items-center gap-2 border-2 border-[var(--line)] px-3 py-2 has-checked:bg-[var(--surface)]">
                      <input type="radio" name={soal.id} value={String(j)} class="radio-nol" />
                      <span>{pil}</span>
                    </label>
                  ))}
                </div>
                <p class="penjelasan mt-3 hidden border-2 border-dashed border-[var(--line)] bg-[var(--surface)] p-3 text-sm"></p>
              </fieldset>
            ))
          }
        </div>
        <button type="submit" class="btn-loket mt-5 inline-flex min-h-[44px] items-center gap-2 border-2 border-[var(--line)] bg-[var(--loket)] px-6 py-3 font-bold text-white">
          <Icon name="tabler:check" class="h-5 w-5" aria-hidden="true" /> Periksa jawaban
        </button>
        <div id="kuis-hasil" class="mt-4 border-2 border-[var(--line)] bg-white p-4" hidden>
          <p id="kuis-skor" class="text-lg font-bold"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ RIWAYAT ============ -->
  <section id="riwayat" class="wipe mx-auto max-w-6xl px-4 py-6">
    <div class="sticker p-5 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex items-start gap-3">
          <Icon name="tabler:history" class="h-8 w-8 shrink-0" aria-hidden="true" />
          <div>
            <h2 class="font-heading text-3xl font-bold sm:text-4xl">Riwayat karcis</h2>
            <p class="mt-1 text-[var(--redup)]">Semua kirimanmu keluar sebagai karcis. Yang bertanda CONTOH adalah karcis bawaan latihan.</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter riwayat">
          <button type="button" class="filter-riwayat btn-loket min-h-[44px] border-2 border-[var(--line)] bg-white px-3 py-2 text-sm font-bold" data-filter="semua" aria-pressed="true">Semua</button>
          <button type="button" class="filter-riwayat btn-loket min-h-[44px] border-2 border-[var(--line)] bg-white px-3 py-2 text-sm font-bold" data-filter="kirim" aria-pressed="false">Keluar</button>
